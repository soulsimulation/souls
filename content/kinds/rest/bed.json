{
  "format": "souls-entry/1",
  "kind": "eden:bed",
  "owner": "thing",
  "state": {
    "covers": {
      "n": 1,
      "type": "enum",
      "values": ["turned_down", "pulled_up"],
      "default": "turned_down",
      "audience": { "rule": "everyone" }
    }
  },
  "links": { "sleeper": { "n": 1, "from": "body", "most": 2, "audience": { "rule": "everyone" } } },
  "points": {
    "left_side": { "role": "stand", "at_mm": [-1035, 0, -100], "yaw_mdeg": 90000 },
    "right_side": { "role": "stand", "at_mm": [1035, 0, -100], "yaw_mdeg": 270000 },
    "foot": { "role": "grip", "at_mm": [0, 520, 900] }
  },
  "slots": {
    "left": { "admits": "body", "posture": "lie", "most": 1, "at_mm": [-360, 500, -100], "stand": "left_side" },
    "right": { "admits": "body", "posture": "lie", "most": 1, "at_mm": [360, 500, -100], "stand": "right_side" }
  },
  "geometry": { "bounds_mm": [1470, 960, 2060] },
  "forms": {
    "lie": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "side": {
          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "slot_free", "slot": { "arg": "side" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "side" } }, { "step": "sit", "slot": { "arg": "side" } }],
      "effects": [
        { "change": "reparent", "what": "actor", "into": { "arg": "side" }, "event": "lay_down" },
        { "change": "link", "link": "sleeper", "from": "actor", "event": "lying_in" }
      ]
    },
    "sleep": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "side": {
          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "slot_free", "slot": { "arg": "side" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "side" } }, { "step": "sit", "slot": { "arg": "side" } }],
      "effects": [
        { "change": "reparent", "what": "actor", "into": { "arg": "side" }, "event": "fell_asleep" },
        { "change": "link", "link": "sleeper", "from": "actor", "event": "lying_in" },
        { "change": "set", "field": "covers", "to": "pulled_up", "event": "covers_pulled_up" }
      ]
    },
    "get_up": {
      "who": { "link": "sleeper" },
      "starts": "act",
      "needs": [{ "need": "linked", "link": "sleeper" }],
      "steps": [{ "step": "rise" }],
      "effects": [
        { "change": "unlink", "link": "sleeper", "from": "actor", "event": "got_up" },
        { "change": "reparent", "what": "actor", "into": "here", "event": "stood_by" }
      ]
    },
    "get_under_covers": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "side": {
          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "slot_free", "slot": { "arg": "side" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "side" } }, { "step": "sit", "slot": { "arg": "side" } }],
      "effects": [
        { "change": "reparent", "what": "actor", "into": { "arg": "side" }, "event": "got_into_bed" },
        { "change": "link", "link": "sleeper", "from": "actor", "event": "lying_in" },
        { "change": "set", "field": "covers", "to": "pulled_up", "event": "covers_pulled_up" }
      ]
    },
    "make": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "unlinked", "link": "sleeper" }, { "need": "within_reach", "point": "foot" }],
      "steps": [{ "step": "walk_to", "point": "foot" }, { "step": "move", "move": "press", "at": "foot" }],
      "effects": [{ "change": "set", "field": "covers", "to": "turned_down", "event": "bed_made" }]
    }
  },
  "areas": { "mattress": { "allows": { "lie": "on", "sit": "edge" } } },
  "motion": { "how": "two_souls" },
  "loose": { "ever": true },
