{
  "format": "souls-entry/1",
  "kind": "eden:tent",
  "owner": "thing",
  "state": { "open": { "n": 1, "type": "bool", "default": false, "audience": { "rule": "everyone" } } },
  "links": { "sleeper": { "n": 1, "from": "body", "most": 1, "audience": { "rule": "everyone" } } },
  "points": {
    "door": { "role": "stand", "at_mm": [0, 0, 1600], "yaw_mdeg": 180000 },
    "flap": { "role": "grip", "at_mm": [0, 800, 1150] }
  },
  "slots": { "inside": { "admits": "body", "posture": "lie", "most": 1, "at_mm": [0, 100, -300], "stand": "door" } },
  "geometry": { "bounds_mm": [1981, 1330, 2500] },
  "forms": {
    "lie": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "place": {
          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "state", "field": "open", "is": true }, { "need": "slot_free", "slot": { "arg": "place" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "place" } }, { "step": "sit", "slot": { "arg": "place" } }],
      "effects": [
        { "change": "reparent", "what": "actor", "into": { "arg": "place" }, "event": "lay_down" },
        { "change": "link", "link": "sleeper", "from": "actor", "event": "lying_in" }
      ]
    },
    "sleep": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "place": {
          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "state", "field": "open", "is": true }, { "need": "slot_free", "slot": { "arg": "place" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "place" } }, { "step": "sit", "slot": { "arg": "place" } }],
      "effects": [
        { "change": "reparent", "what": "actor", "into": { "arg": "place" }, "event": "fell_asleep" },
        { "change": "link", "link": "sleeper", "from": "actor", "event": "lying_in" }
      ]
    },
    "get_up": {
      "who": { "link": "sleeper" },
      "starts": "act",
      "needs": [{ "need": "linked", "link": "sleeper" }],
      "steps": [{ "step": "rise" }],
      "effects": [
        { "change": "unlink", "link": "sleeper", "from": "actor", "event": "got_up" },
        { "change": "reparent", "what": "actor", "into": "here", "event": "stood_by" }
      ]
    },
    "open_flap": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "state", "field": "open", "is": false }, { "need": "within_reach", "point": "flap" }],
      "steps": [{ "step": "walk_to", "point": "flap" }, { "step": "move", "move": "press", "at": "flap" }],
      "effects": [{ "change": "set", "field": "open", "to": true, "event": "flap_opened" }]
    },
    "close_flap": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "state", "field": "open", "is": true }, { "need": "within_reach", "point": "flap" }],
      "steps": [{ "step": "walk_to", "point": "flap" }, { "step": "move", "move": "press", "at": "flap" }],
      "effects": [{ "change": "set", "field": "open", "to": false, "event": "flap_closed" }]
    }
  },
  "motion": { "how": "fixed" },
  "loose": { "ever": true },
  "looks": {
    "model": "look:tent",
    "shape": {
      "shapes": [
        { "kind": "box", "at": [0, 20, 0], "size": [1900, 40, 2300], "round": 0, "tint": "floor" },
        { "kind": "box", "at": [0, 60, -200], "size": [1200, 50, 1800], "round": 0, "tint": "mat" },
        {
          "kind": "rbox",
          "at": [-500, 620, 0],
          "size": [60, 1420, 2400],
          "tint": "canvas",
          "round": 30,
          "roll": -41253
        },
        {
          "kind": "rbox",
          "at": [500, 620, 0],
          "size": [60, 1420, 2400],
          "tint": "canvas",
          "round": 30,
          "roll": 41253
        },
        { "kind": "box", "at": [0, 620, -1200], "size": [1950, 1200, 40], "round": 0, "tint": "canvas2" },
        { "kind": "cyl", "at": [0, 1300, 0], "r": 30, "h": 2500, "segments": 5, "tint": "pole", "pitch": 90000 },
        {
          "kind": "box",
          "at": [0, 550, 1120],
          "size": [1000, 1050, 30],
          "round": 0,
          "tint": "flap",
          "role": "door",
          "pivot": [-500, 0, 1150]
        }
      ],
      "palette": {
        "canvas": "#d06a3a",
        "canvas2": "#b85a30",
        "flap": "#e08a50",
        "floor": "#4a4f42",
        "mat": "#3f6b8a",
        "pole": "#5a5f62"
      },
      "tags": ["building", "shelter", "camping"]
    },
    "table": [
      {
        "part": "door",
        "field": "open",
        "do": "rotate",
        "axis": "y",
        "at": { "true": -110000, "false": 0 },
        "over_us": 700000
      }
    ]
  },
  "text": { "card": "A tent with a door flap and a mat inside, where one lies or sleeps.", "bed": "bed", "camp": "camp" },
  "card": { "text": "card", "category": "bed", "synonyms": ["camp"] }
}
