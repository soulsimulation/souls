{
  "format": "souls-entry/1",
  "kind": "eden:kettle",
  "owner": "thing",
  "state": {
    "water": { "n": 1, "type": "enum", "values": ["empty", "cold", "hot"], "default": "empty", "audience": { "rule": "everyone" } },
    "heating": { "n": 2, "type": "bool", "default": false, "audience": { "rule": "everyone" } }
  },
  "points": {
    "grip": { "role": "grip", "at_mm": [-135, 150, 0] },
    "button": { "role": "contact", "at_mm": [-118, 236, 0] },
    "spout": { "role": "outlet", "at_mm": [268, 196, 0], "yaw_mdeg": 0 },
    "stand": { "role": "stand", "at_mm": [-118, 0, 450] }
  },
  "geometry": { "bounds_mm": [560, 260, 200] },
  "forms": {
    "fill": {
      "who": "holder",
      "starts": "act",
      "takes": {
        "from": { "type": "thing", "select": { "of": "things", "kind": "eden:tap", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } }
      },
      "needs": [
        { "need": "held_by_actor" },
        { "need": "state", "field": "water", "is": "empty" },
        { "need": "within_reach", "point": { "arg": "from" } }
      ],
      "steps": [{ "step": "move", "move": "fill", "at": "spout", "toward": { "arg": "from" } }],
      "effects": [{ "change": "set", "field": "water", "to": "cold", "event": "filled" }]
    },
    "switch_on": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "heating", "is": false },
        { "need": "state", "field": "water", "not": "empty" },
        { "need": "within_reach", "point": "button" }
      ],
      "steps": [{ "step": "move", "move": "press", "at": "button" }],
      "effects": [
        { "change": "set", "field": "heating", "to": true, "event": "switched_on" },
        { "change": "timer", "form": "boiled", "after_us": 150000000, "event": "boil_started" }
      ]
    },
    "boiled": {
      "who": "world",
      "starts": "timer",
      "needs": [{ "need": "state", "field": "heating", "is": true }],
      "steps": [],
      "effects": [
        { "change": "set", "field": "water", "to": "hot", "event": "boiled" },
        { "change": "set", "field": "heating", "to": false, "event": "switched_off" }
      ]
    },
    "pour": {
      "who": "holder",
      "starts": "act",
      "takes": {
        "into": { "type": "thing", "select": { "of": "things", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } }
      },
      "needs": [
        { "need": "held_by_actor" },
        { "need": "state", "field": "water", "not": "empty" }
      ],
      "steps": [{ "step": "move", "move": "pour", "at": "spout", "toward": { "arg": "into" } }],
      "effects": [{ "change": "set", "field": "water", "to": "empty", "event": "poured" }]
    }
  },
