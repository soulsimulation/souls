  "geometry": { "bounds_mm": [560, 260, 200] },
  "forms": {
    "take": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "hand", "free": true }],
      "steps": [{ "step": "take" }],
      "effects": [{ "change": "reparent", "what": "this", "into": "actor_hand", "event": "taken" }]
    },
    "fill": {
      "who": "holder",
      "starts": "act",
      "takes": {
        "from": { "type": "thing", "select": { "of": "things", "kind": "eden:sink", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } }
      },
      "needs": [
        { "need": "held_by_actor" },
        { "need": "state", "field": "water", "at_most": 0 }
      ],
      "steps": [{ "step": "walk_to", "point": { "arg": "from" } }, { "step": "move", "move": "fill", "toward": { "arg": "from" } }],
      "effects": [{ "change": "transfer", "field": "water", "from": { "arg": "from" }, "into": "this", "amount": "room", "event": "filled" }]
    },
    "switch_on": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "heating", "is": false },
        { "need": "state", "field": "water", "at_least": 1 },
        { "need": "within_reach", "point": "button" }
      ],
      "steps": [{ "step": "move", "move": "press", "at": "button" }],
      "effects": [
        { "change": "set", "field": "heating", "to": true, "event": "switched_on" },
        { "change": "set", "field": "heat", "rate": 500, "event": "warming" },
        { "change": "timer", "form": "boiled", "after_us": 150000000, "event": "will_boil" }
      ]
    },
    "boiled": {
      "who": "world",
      "starts": "timer",
      "needs": [
        { "need": "state", "field": "heating", "is": true },
        { "need": "state", "field": "heat", "at_least": 100000 }
      ],
      "steps": [],
      "effects": [
        { "change": "set", "field": "heating", "to": false, "event": "boiled" },
        { "change": "set", "field": "heat", "rate": -50, "event": "cooling" }
      ]
    },
    "pour": {
      "who": "holder",
      "starts": "act",
      "takes": {
        "into": { "type": "thing", "select": { "of": "things", "kind": "eden:cup", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } }
      },
      "needs": [
        { "need": "held_by_actor" },
        { "need": "state", "field": "water", "at_least": 1 }
      ],
      "steps": [{ "step": "move", "move": "pour", "at": "spout", "toward": { "arg": "into" } }],
      "effects": [{ "change": "transfer", "field": "water", "from": "this", "into": { "arg": "into" }, "amount": "room", "event": "poured" }]
    }
  },
  "motion": { "how": "one_hand" },
  "loose": { "ever": true },
  "looks": {
    "model": "look:kettle",
