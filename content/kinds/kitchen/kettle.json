    "heat": { "n": 30, "type": "timed", "unit": "mC", "default": { "value": 25000, "per_s": 0, "set_us": 0 }, "min": 25000, "max": 100000, "audience": { "rule": "everyone" } }
  },
  "points": {
    "grip": { "role": "grip", "at_mm": [-135, 150, 0] },
