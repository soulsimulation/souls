        { "change": "set", "field": "stage", "to": "flowering", "event": "flowered" },
        { "change": "set", "field": "ripening", "to": 0, "rate": 1, "event": "ripening_restarted" },
        { "change": "timer", "form": "fruit", "after_us": 86400000000, "event": "fruit_due" }
      ]
    },
    "fruit": {
      "who": "world",
      "starts": "timer",
      "needs": [
        { "need": "state", "field": "water", "at_least": 1360000 },
        { "need": "state", "field": "stage", "is": "flowering" },
        { "need": "state", "field": "ripening", "at_least": 86400 }
      ],
      "steps": [],
      "effects": [
        { "change": "set", "field": "stage", "to": "fruiting", "event": "fruited" },
        { "change": "set", "field": "fruit", "to": 3, "event": "ripe" },
        { "change": "set", "field": "ripening", "to": 0, "rate": 1, "event": "ripening_restarted" }
