{
  "format": "souls-entry/1",
  "kind": "eden:planter",
  "owner": "thing",
  "state": {
    "water": { "n": 1, "type": "timed", "unit": "mg", "default": { "value": 400000, "per_s": -5, "set_us": 0 }, "min": 0, "max": 4000000, "audience": { "rule": "everyone" } },
    "stage": { "n": 2, "type": "enum", "values": ["bare", "seed", "sprout", "leafy", "flowering", "fruiting"], "default": "bare", "audience": { "rule": "everyone" } },
    "ripening": { "n": 3, "type": "timed", "unit": "count", "default": { "value": 0, "per_s": 1, "set_us": 0 }, "min": 0, "audience": { "rule": "everyone" } },
    "fruit": { "n": 4, "type": "int", "unit": "count", "default": 0, "min": 0, "max": 6, "audience": { "rule": "everyone" } },
    "tray": { "n": 5, "type": "int", "unit": "count", "default": 1, "min": 0, "max": 1, "audience": { "rule": "everyone" } },
    "weeds": { "n": 6, "type": "bool", "default": true, "audience": { "rule": "everyone" } },
    "compost": { "n": 7, "type": "int", "unit": "count", "default": 0, "min": 0, "max": 4, "audience": { "rule": "everyone" } }
  },
  "points": {
    "soil": { "role": "contact", "at_mm": [0,372,0] },
    "stand": { "role": "stand", "at_mm": [0,0,600] }
  },
  "slots": {
    "out": { "admits": "thing", "kinds": ["eden:weed_bundle"], "most": 1, "at_mm": [530,372,0], "fits_mm": [220,110,250] }
  },
  "geometry": { "bounds_mm": [900,900,500] },
  "forms": {
    "sow": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "stage", "is": "bare" },
        { "need": "within_reach", "point": "soil" }
      ],
      "steps": [
        { "step": "move", "move": "press", "at": "soil" }
      ],
      "effects": [
        { "change": "set", "field": "stage", "to": "seed", "event": "sown" },
        { "change": "set", "field": "ripening", "to": 0, "rate": 1, "event": "ripening_restarted" },
        { "change": "timer", "form": "sprout", "after_us": 86400000000, "event": "sprout_due" }
      ]
    },
    "plant": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "stage", "is": "bare" },
        { "need": "state", "field": "tray", "at_least": 1 },
        { "need": "hand", "free": true },
        { "need": "within_reach", "point": "soil" }
      ],
      "steps": [
        { "step": "move", "move": "press", "at": "soil" }
      ],
      "effects": [
        { "change": "set", "field": "tray", "by": -1, "event": "tray_used" },
        { "change": "set", "field": "stage", "to": "sprout", "event": "seedlings_planted" },
        { "change": "set", "field": "ripening", "to": 0, "rate": 1, "event": "ripening_restarted" },
        { "change": "timer", "form": "leaf", "after_us": 86400000000, "event": "leaf_due" }
      ]
    },
    "weed": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "weeds", "is": true },
        { "need": "slot_free", "slot": "out" },
        { "need": "hand", "free": true },
        { "need": "within_reach", "point": "soil" }
      ],
      "steps": [
        { "step": "move", "move": "pick", "at": "soil" }
      ],
      "effects": [
        { "change": "set", "field": "weeds", "to": false, "event": "weeded" },
        { "change": "create", "kind": "eden:weed_bundle", "into": "out", "event": "weeds_bundled" }
      ]
    },
    "feed": {
      "who": "anyone",
      "starts": "act",
      "takes": { "bin": { "type": "thing", "select": { "of": "things", "kind": "eden:compost_bin", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } } },
      "needs": [
        { "need": "state", "field": "stage", "not": "bare" },
        { "need": "state", "field": "stage", "not": "fruiting" },
        { "need": "state", "field": "water", "at_least": 1360000 },
        { "need": "enough" },
        { "need": "room" },
        { "need": "hand", "free": true },
        { "need": "within_reach", "point": "soil" }
      ],
      "steps": [
        { "step": "move", "move": "slide", "at": "soil" }
      ],
      "effects": [
        { "change": "transfer", "field": "compost", "from": { "arg": "bin" }, "into": "this", "amount": 1, "event": "fed" },
        { "change": "set", "field": "ripening", "to": 86400, "rate": 1, "event": "ripened_by_compost" },
        { "change": "timer", "form": "sprout", "after_us": 1, "event": "sprout_due" },
        { "change": "timer", "form": "leaf", "after_us": 1, "event": "leaf_due" },
        { "change": "timer", "form": "flower", "after_us": 1, "event": "flower_due" },
        { "change": "timer", "form": "fruit", "after_us": 1, "event": "fruit_due" }
      ]
    },
    "water": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "hand", "holds": "eden:watering_can" }
      ],
      "steps": [
        { "step": "move", "move": "pour", "at": "soil" }
      ],
      "effects": [
        { "change": "set", "field": "water", "to": 4000000, "rate": -5, "event": "watered" },
        { "change": "timer", "form": "sprout", "after_us": 86400000000, "event": "sprout_due" },
        { "change": "timer", "form": "leaf", "after_us": 86400000000, "event": "leaf_due" },
        { "change": "timer", "form": "flower", "after_us": 86400000000, "event": "flower_due" },
        { "change": "timer", "form": "fruit", "after_us": 86400000000, "event": "fruit_due" }
      ]
    },
    "pick": {
      "who": "anyone",
      "starts": "act",
      "takes": { "basket": { "type": "thing", "select": { "of": "things", "kind": "eden:basket", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } } },
      "needs": [
        { "need": "state", "field": "stage", "is": "fruiting" },
        { "need": "room" }
      ],
      "steps": [
        { "step": "move", "move": "pick", "at": "soil" }
      ],
      "effects": [
        { "change": "transfer", "field": "fruit", "from": "this", "into": { "arg": "basket" }, "amount": 3, "event": "picked" },
        { "change": "set", "field": "stage", "to": "flowering", "event": "back_to_flowering" },
        { "change": "set", "field": "ripening", "to": 0, "rate": 1, "event": "ripening_restarted" },
        { "change": "timer", "form": "fruit", "after_us": 86400000000, "event": "fruit_due" }
