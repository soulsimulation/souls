        {
          "step": "walk_to",
          "point": {"arg": "board"}
        },
        {"step": "wait", "us": 10000000}
      ],
      "effects": [
        {"change": "set", "field": "stage", "to": "folded", "event": "folded"}
      ]
    }
  },
