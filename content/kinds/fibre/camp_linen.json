            "anchor": "this",
            "order": "nearest",
            "rank": 1
          }
        }
      },
      "needs": [
        {"need": "state", "field": "stage", "is": "wet", "says": "wash_first"},
        {"need": "hand", "empty": true, "says": "put_down_first"}
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": {"arg": "board"}
        },
        {"step": "wait", "us": 10000000}
      ],
      "effects": [
        {"change": "set", "field": "stage", "to": "damp", "event": "wrung"}
      ]
    },
    "fold": {
