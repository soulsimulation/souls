{
  "format": "souls-entry/1",
  "kind": "eden:camp_cord",
  "owner": "thing",
  "state": {
    "prepared": {
      "n": 1,
      "type": "enum",
      "values": ["loose", "loop", "guyline"],
      "default": "loose",
      "audience": {"rule": "everyone"}
    },
    "binding": {
      "n": 2,
      "type": "int",
      "unit": "count",
      "default": 0,
      "min": 0,
      "max": 1,
      "audience": {"rule": "everyone"}
    }
  },
  "points": {
    "grip": {
      "role": "grip",
      "at_mm": [0, 30, 0]
    }
  },
  "geometry": {
    "bounds_mm": [400, 60, 300]
  },
  "forms": {
    "take": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {"need": "hand", "free": true}
      ],
      "steps": [
        {"step": "take"}
      ],
      "effects": [
        {"change": "reparent", "what": "this", "into": "actor_hand", "event": "taken"}
      ]
    },
    "tie_loop": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "board": {
          "type": "thing",
          "select": {
            "of": "things",
            "kind": "eden:cordage_board",
            "in": "here",
            "anchor": "this",
            "order": "nearest",
            "rank": 1
          }
        }
      },
      "needs": [
        {"need": "state", "field": "prepared", "is": "loose", "says": "needs_loose"},
        {"need": "enough", "says": "needs_loose"},
        {"need": "hand", "empty": true, "says": "put_down_first"}
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": {"arg": "board"}
        },
        {"step": "wait", "us": 10000000}
      ],
      "effects": [
        {
          "change": "transfer",
          "field": "binding",
          "from": {"arg": "board"},
          "into": "this",
          "amount": 1,
          "event": "binding_taken"
        },
        {"change": "set", "field": "prepared", "to": "loop", "event": "tied_loop"}
      ]
    },
    "tie_guyline": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "board": {
          "type": "thing",
          "select": {
            "of": "things",
            "kind": "eden:cordage_board",
            "in": "here",
            "anchor": "this",
            "order": "nearest",
            "rank": 1
          }
        }
      },
      "needs": [
        {"need": "state", "field": "prepared", "is": "loose", "says": "needs_loose"},
        {"need": "enough", "says": "needs_loose"},
        {"need": "hand", "empty": true, "says": "put_down_first"}
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": {"arg": "board"}
        },
        {"step": "wait", "us": 10000000}
      ],
      "effects": [
        {
          "change": "transfer",
          "field": "binding",
          "from": {"arg": "board"},
          "into": "this",
          "amount": 1,
          "event": "binding_taken"
        },
        {"change": "set", "field": "prepared", "to": "guyline", "event": "tied_guyline"}
      ]
    },
    "untie": {
      "who": "anyone",
      "starts": "act",
      "takes": {
        "board": {
          "type": "thing",
          "select": {
            "of": "things",
            "kind": "eden:cordage_board",
            "in": "here",
            "anchor": "this",
            "order": "nearest",
            "rank": 1
          }
        }
      },
      "needs": [
        {"need": "state", "field": "prepared", "not": "loose", "says": "return_first"},
        {"need": "room", "says": "return_first"},
        {"need": "hand", "empty": true, "says": "put_down_first"}
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": {"arg": "board"}
        },
        {"step": "wait", "us": 10000000}
      ],
      "effects": [
        {
          "change": "transfer",
          "field": "binding",
          "from": "this",
          "into": {"arg": "board"},
          "amount": 1,
          "event": "binding_returned"
        },
        {"change": "set", "field": "prepared", "to": "loose", "event": "untied"}
      ]
    }
  },
  "motion": { "how": "one_hand" },
  "loose": { "ever": true },
