        0,
        1050,
        -90
      ]
    }
  },
  "geometry": {
    "bounds_mm": [
      500,
      1400,
      400
    ]
  },
  "forms": {
    "turn_forward": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "open_first",
          "is": false
        },
        {
          "need": "state",
          "field": "pattern",
          "at_most": 4,
          "says": "last_detent"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "turn",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "pattern",
          "by": 1,
          "event": "chamber_turned_forward"
        }
      ]
    },
    "turn_backward": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "open_first",
          "is": false
        },
        {
          "need": "state",
          "field": "pattern",
          "at_least": 1,
          "says": "first_detent"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "turn",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "pattern",
          "by": -1,
          "event": "chamber_turned_backward"
        }
      ]
    },
    "complete_turn": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "open_first",
          "is": false
        },
        {
          "need": "state",
          "field": "pattern",
          "says": "turn_to_last",
          "at_least": 5,
          "at_most": 5
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "turn",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "pattern",
          "to": 0,
          "event": "chamber_full_turn"
        }
      ]
    },
    "close_eyepiece": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "already_closed",
          "is": false
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "shutter",
          "to": true,
          "event": "eyepiece_closed"
        }
      ]
    },
    "open_eyepiece": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "already_open",
          "is": true
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "shutter",
          "to": false,
          "event": "eyepiece_opened"
        }
      ]
    }
  },
