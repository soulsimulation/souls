    "pattern": {
      "n": 28,
      "type": "int",
      "unit": "count",
      "min": 0,
      "max": 5,
      "default": 0,
      "audience": {
        "rule": "everyone"
      }
    },
    "shutter": {
      "n": 29,
      "type": "bool",
      "default": false,
      "audience": {
        "rule": "everyone"
      }
    }
  },
  "points": {
    "stand": {
      "role": "stand",
