    "turn_chamber": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "open_first",
          "is": false
        },
        {
          "need": "state",
          "field": "pattern",
          "not": {
            "arg": "pattern"
          },
          "says": "different_pattern"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "turn",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "pattern",
          "to": {
            "arg": "pattern"
          },
          "event": "chamber_turned"
        }
      ],
      "takes": {
        "pattern": {
          "type": "value",
          "of": [
            "star",
            "flower",
            "snowflake",
            "fan",
            "wheel",
            "hexagon"
          ]
        }
      }
    },
    "close_eyepiece": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "already_closed",
          "is": false
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "shutter",
          "to": true,
          "event": "eyepiece_closed"
        }
      ]
    },
    "open_eyepiece": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "shutter",
          "says": "already_open",
          "is": true
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "shutter",
          "to": false,
          "event": "eyepiece_opened"
        }
