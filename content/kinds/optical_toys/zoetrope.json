{
  "format": "souls-entry/1",
  "kind": "eden:zoetrope",
  "owner": "thing",
  "state": {
    "strip": {
      "n": 28,
      "type": "enum",
      "default": "none",
      "audience": {
        "rule": "everyone"
      },
      "values": [
        "none",
        "horse",
        "bouncing_ball"
      ]
    },
    "spinning": {
      "n": 29,
      "type": "bool",
      "default": false,
      "audience": {
        "rule": "everyone"
      }
    }
  },
  "points": {
    "stand": {
      "role": "stand",
      "at_mm": [
        0,
        0,
        -430
      ],
      "yaw_mdeg": 0
    },
    "control": {
      "role": "contact",
      "at_mm": [
        0,
        1050,
        -90
      ]
    }
  },
  "geometry": {
    "bounds_mm": [
      500,
      1400,
      400
    ]
  },
  "forms": {
    "fit_strip": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "spinning",
          "says": "brake_first",
          "is": false
        },
        {
          "need": "state",
          "field": "strip",
          "says": "remove_first",
          "is": "none"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "strip",
          "to": {
            "arg": "strip"
          },
          "event": "picture_strip_fitted"
        }
      ],
      "takes": {
        "strip": {
          "type": "value",
          "of": [
            "horse",
            "bouncing_ball"
          ]
        }
      }
    },
    "remove_strip": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "spinning",
          "says": "brake_first",
          "is": false
        },
        {
          "need": "state",
          "field": "strip",
          "not": "none",
          "says": "no_strip"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "strip",
          "to": "none",
          "event": "picture_strip_removed"
        }
      ]
    },
    "spin_drum": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "spinning",
          "says": "brake_first",
          "is": false
        },
        {
          "need": "state",
          "field": "strip",
          "not": "none",
          "says": "no_strip"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "turn",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "spinning",
          "to": true,
          "event": "picture_drum_spun"
        },
        {
          "change": "timer",
          "form": "coast_to_stop",
          "after_us": 8000000,
          "event": "drum_coasting"
        }
      ]
    },
    "brake_drum": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "spinning",
          "says": "already_stopped",
          "is": true
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "press",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "spinning",
          "to": false,
          "event": "picture_drum_braked"
        }
      ]
    },
    "coast_to_stop": {
      "who": "world",
      "starts": "timer",
      "needs": [
        {
          "need": "state",
          "field": "spinning",
          "is": true
        }
      ],
      "steps": [],
      "effects": [
        {
          "change": "set",
          "field": "spinning",
          "to": false,
          "event": "picture_drum_stopped"
        }
      ]
    }
  },
  "motion": {
    "how": "fixed"
  },
  "loose": {
    "ever": true
  },
