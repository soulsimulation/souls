{
  "format": "souls-entry/1",
  "kind": "eden:flipbook",
  "owner": "thing",
  "state": {
    "open": {
      "n": 28,
      "type": "bool",
      "default": false,
      "audience": {
        "rule": "everyone"
      }
    },
    "page": {
      "n": 29,
      "type": "int",
      "default": 0,
      "audience": {
        "rule": "everyone"
      },
      "unit": "count",
      "min": 0,
      "max": 8
    }
  },
  "points": {
    "stand": {
      "role": "stand",
      "at_mm": [
        0,
        0,
        -430
      ],
      "yaw_mdeg": 0
    },
    "control": {
      "role": "contact",
      "at_mm": [
        0,
        1050,
        -90
      ]
    }
  },
  "geometry": {
    "bounds_mm": [
      500,
      1400,
      400
    ]
  },
  "forms": {
    "open_book": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "open",
          "says": "already_open",
          "is": false
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "open",
          "to": true,
          "event": "flipbook_opened"
        }
      ]
    },
    "close_book": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "open",
          "says": "open_first",
          "is": true
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "open",
          "to": false,
          "event": "flipbook_closed"
        }
      ]
    },
    "riffle_page": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "open",
          "says": "open_first",
          "is": true
        },
        {
          "need": "state",
          "field": "page",
          "at_most": 7,
          "says": "last_page"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "stroke",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "page",
          "by": 1,
          "event": "picture_page_riffled"
        }
      ]
    },
    "rewind_pages": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        {
          "need": "state",
          "field": "open",
          "says": "open_first",
          "is": true
        },
        {
          "need": "state",
          "field": "page",
          "at_least": 1,
          "says": "first_page"
        },
        {
          "need": "hand",
          "empty": true,
          "says": "empty_hands"
        }
      ],
      "steps": [
        {
          "step": "walk_to",
          "point": "stand"
        },
        {
          "step": "move",
          "move": "slide",
          "at": "control"
        }
      ],
      "effects": [
        {
          "change": "set",
          "field": "page",
          "to": 0,
          "event": "picture_pages_rewound"
        }
      ]
    }
  },
  "motion": {
    "how": "fixed"
  },
  "loose": {
    "ever": true
  },
