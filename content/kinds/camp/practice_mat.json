{
  "format": "souls-entry/1",
  "kind": "eden:practice_mat",
  "owner": "thing",
  "state": {
    "deployed": { "n": 1, "type": "bool", "default": false, "audience": { "rule": "everyone" } }
  },
  "points": {
    "side": { "role": "stand", "at_mm": [0, 0, 1000] },
    "centre": { "role": "stand", "at_mm": [0, 0, 0] }
  },
  "slots": {
    "on": { "admits": "body", "posture": "lie", "most": 1, "at_mm": [0, 20, 0], "stand": "side" }
  },
  "geometry": { "bounds_mm": [1600, 230, 1200] },
  "forms": {
    "unroll": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "deployed", "is": false, "says": "unroll_the_roll" },
        { "need": "slot_free", "slot": "on", "says": "footprint_occupied" },
        { "need": "hand", "empty": true, "says": "put_down_first" }
      ],
      "steps": [
        { "step": "walk_to", "point": "side" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [{ "change": "set", "field": "deployed", "to": true, "event": "unrolled" }]
    },
    "roll_up": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "deployed", "is": true, "says": "roll_up_the_mat" },
        { "need": "slot_free", "slot": "on", "says": "footprint_occupied" },
        { "need": "hand", "empty": true, "says": "put_down_first" }
      ],
      "steps": [
        { "step": "walk_to", "point": "side" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [{ "change": "set", "field": "deployed", "to": false, "event": "rolled_up" }]
    },
    "stretch": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "deployed", "is": true, "says": "roll_up_the_mat" },
        { "need": "slot_free", "slot": "on", "says": "footprint_occupied" },
        { "need": "hand", "empty": true, "says": "put_down_first" }
      ],
      "steps": [
        { "step": "walk_to", "point": "centre" },
        { "step": "move", "move": "stretch", "at": "centre" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": []
    }
  },
  "looks": {
    "model": "look:practice_mat",
    "table": [
      { "part": "fill", "field": "deployed", "do": "show", "at": { "true": 1, "false": 0 } },
