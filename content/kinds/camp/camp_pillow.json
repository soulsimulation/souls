  "geometry": { "bounds_mm": [500, 230, 300] },
  "forms": {
    "patch": {
      "who": "anyone",
      "starts": "act",
      "takes": { "kit": { "type": "thing", "select": { "of": "things", "kind": "eden:pillow_repair_kit", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } } },
      "needs": [
        { "need": "state", "field": "patches", "at_most": 0, "says": "already_patched" },
        { "need": "enough", "says": "no_patch" },
        { "need": "hand", "empty": true, "says": "empty_hands" }
      ],
      "steps": [
        { "step": "move", "move": "press", "at": "valve" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [{ "change": "transfer", "field": "patches", "from": { "arg": "kit" }, "into": "this", "amount": 1, "event": "patched" }]
    },
    "inflate": {
      "who": "anyone",
      "starts": "act",
      "takes": { "kit": { "type": "thing", "select": { "of": "things", "kind": "eden:pillow_repair_kit", "in": "here", "anchor": "me", "order": "nearest", "rank": 1 } } },
      "needs": [
        { "need": "state", "field": "patches", "at_least": 1, "says": "patch_first" },
        { "need": "enough", "says": "no_air" },
        { "need": "room", "says": "fully_inflated" },
        { "need": "hand", "empty": true, "says": "empty_hands" }
      ],
      "steps": [
        { "step": "move", "move": "press", "at": "valve" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [{ "change": "transfer", "field": "air", "from": { "arg": "kit" }, "into": "this", "amount": 1, "event": "inflated" }]
    },
    "vent": {
      "who": "anyone",
      "starts": "act",
      "needs": [
        { "need": "state", "field": "air", "at_least": 1, "says": "already_flat" },
        { "need": "hand", "empty": true, "says": "empty_hands" }
      ],
      "steps": [
        { "step": "move", "move": "press", "at": "valve" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [{ "change": "set", "field": "air", "to": 0, "event": "vented" }]
    }
  },
