  "text": {
    "display": "display",
    "card": "Semaphore display: select a letter (1=A to 26=Z), or 0 to rest.",
    "semaphore": "semaphore alphabet station",
    "flags": "paired flag display",
    "alphabet": "semaphore learning display",
    "hands_empty": "Put down what you hold before selecting a signal.",
    "begin": "Stand on the F-marked front/receiver side. L marks the signaler left shoulder at your right; R marks the signaler right shoulder at your left. Red and yellow flags stay attached to their distinct arm assemblies, which have a small fixed depth separation for crossed positions. Select H, Rest, E, Rest, L, Rest, P, Rest to display HELP. Select Rest between letters, including repeated letters. Each choice is independent and repeating the same choice leaves the same signal.",
    "limits": "One indexed value selects both rigid arm positions at native hand contact. This is a fixed alphabet learning display: no bodily gesture, handheld flag custody, recipient, delivered message, stored word, numeral mode or attention/error protocol. Read only from the marked front; the rear view mirrors the reference. Positions change discretely without a continuous path, physical arm collision, precise contact or smooth-transition claim."
  },
  "card": {
    "text": "card",
