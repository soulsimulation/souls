{
  "format": "souls-entry/1",
  "kind": "eden:calendar_entry",
  "owner": "thing",
  "state": {
    "start": { "n": 28, "type": "duration", "default": 0, "audience": { "rule": "everyone" } },
    "end": { "n": 29, "type": "duration", "default": 0, "audience": { "rule": "everyone" } },
    "words": { "n": 30, "type": "text", "default": null, "audience": { "rule": "everyone" } }
  },
  "links": {
    "place": { "n": 1, "from": "thing", "most": 1, "audience": { "rule": "everyone" } },
    "poster": { "n": 2, "from": "soul", "most": 1, "audience": { "rule": "everyone" } },
    "interested": { "n": 3, "from": "soul", "most": 500, "audience": { "rule": "everyone" } }
  },
  "forms": {
    "post": {
      "who": "anyone",
      "starts": "act",
      "takes": { "words": { "type": "text" }, "start": { "type": "duration" }, "end": { "type": "duration" } },
      "needs": [{ "need": "unlinked", "link": "poster" }],
      "steps": [],
      "effects": [
        { "change": "link", "link": "poster", "from": "actor", "event": "entry_posted" },
        { "change": "set", "field": "words", "to": { "arg": "words" }, "event": "words_written" },
        { "change": "set", "field": "start", "to": { "arg": "start" }, "event": "start_set" },
        { "change": "set", "field": "end", "to": { "arg": "end" }, "event": "end_set" }
      ]
    },
    "show_interest": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "unlinked", "link": "interested", "end": "actor" }],
      "steps": [],
      "effects": [{ "change": "link", "link": "interested", "from": "actor", "event": "interest_shown" }]
    },
    "drop_interest": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "linked", "link": "interested", "end": "actor" }],
      "steps": [],
      "effects": [{ "change": "unlink", "link": "interested", "from": "actor", "event": "interest_dropped" }]
    },
    "take_down": {
      "who": { "link": "poster" },
      "starts": "act",
      "needs": [{ "need": "linked", "link": "poster", "end": "actor", "says": "not_your_notice" }],
      "steps": [],
      "effects": [
        { "change": "unlink", "link": "interested", "from": "all", "event": "interest_cleared" },
        { "change": "unlink", "link": "poster", "from": "actor", "event": "entry_taken_down" },
        { "change": "set", "field": "words", "to": null, "event": "words_cleared" }
      ]
    }
  },
  "points": { "grip": { "role": "grip", "at_mm": [0, 100, 0] } },
  "geometry": { "bounds_mm": [210, 297, 4], "front": "none" },
  "motion": { "how": "one_hand" },
  "loose": { "ever": true },
  "text": {
    "card": "A notice of something that happens: where, when, and who is interested.",
    "calendar": "calendar",
    "event": "event",
    "notice": "notice",
    "not_your_notice": "Only whoever posted this notice takes it down."
  },
  "card": { "text": "card", "category": "calendar", "synonyms": ["event", "notice"] }
}
