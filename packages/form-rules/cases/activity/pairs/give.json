{
  "format": "souls-activity-steps/1",
  "about": "test:give, a give between two Souls. The offer g1 is a proposal for one Soul (its invited link, b2) that b1 made (its proposer link), naming the thing it offers (its offered link, book1); its countdown left_us says when it lapses. b1 offers by entering the giver's place in its own act; b2 accepts by entering the taker's place in its own act, in time. Only then does the book pass from b1's hand to b2's, in the same batch: both sides or neither. Unaccepted, the offer lapses at the stated microsecond: b1 is released (event test:released) with the book still in its hand, and the outcome is named (test:offer_lapsed). Nothing is done to a Soul that did not join.",
  "cases": [
    {
      "name": "a_book_offered_and_accepted_ends_in_the_others_hand",
      "activity": "g1",
      "state": {
        "nodes": {
          "w": {},
          "r1": { "loose": ["g1", "b1", "b2"] },
          "g1": { "kind": "test:give", "at_mm": [0, 0, 0], "fields": { "left_us": { "value": 30000000, "per_s": -1000000, "set_us": 5000000 } }, "links": { "invited": ["b2"], "proposer": ["b1"], "offered": ["book1"] } },
          "b1": { "hands": { "left": null, "right": "book1" } },
          "b2": { "hands": { "left": null, "right": null } },
          "book1": { "kind": "test:book" }
        }
      },
      "steps": [
        { "do": "offer", "actor": "b1", "form": "offer", "receipt": "o1", "now_us": 6000000, "expect": { "verdict": "yes", "role": "giver", "place": { "node": "g1", "slot": "giver" } } },
        { "do": "accept", "actor": "b2", "form": "accept", "receipt": "a1", "now_us": 9000000, "expect": { "verdict": "yes", "role": "taker", "place": { "node": "g1", "slot": "taker" } } },
        { "do": "leave", "actor": "b1", "form": "let_go", "receipt": "x1", "expect": { "verdict": "yes", "role": "giver", "ended": 1 } }
      ],
      "after": {
        "b1": { "hands": { "left": null, "right": null } },
        "b2": { "hands": { "left": "book1", "right": null } },
        "book1": { "kind": "test:book" }
      },
      "gone": ["g1"]
    },
