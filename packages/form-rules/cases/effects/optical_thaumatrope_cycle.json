{
  "format": "souls-effect-cases/1",
  "about": "Reachable optical play cycles, end stops, refusal without mutation and same-object reuse.",
  "cases": [
    {
      "name": "thaumatrope_cycle_boundaries_and_reuse",
      "state": {
        "actor": "b1",
        "nodes": {
          "t1": {
            "kind": "eden:thaumatrope"
          },
          "b1": {
            "hands": {
              "left": null,
              "right": null
            }
          }
        }
      },
      "do": [
        {
          "act": {
            "this": "t1",
            "form": "release_disc"
