              {
                "change": "set",
                "node": "t1",
                "field": "twists",
                "n": 28,
                "to": 2
              }
            ]
          }
        },
        {
          "act": {
            "this": "t1",
            "form": "wind_strings"
          },
          "receipt": "cycle-3",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "t1",
                "field": "twists",
                "n": 28,
                "to": 3
              }
            ]
          }
        },
        {
          "act": {
            "this": "t1",
            "form": "wind_strings"
          },
          "receipt": "cycle-4",
