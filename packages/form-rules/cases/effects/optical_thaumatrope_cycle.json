            "reason": "field_differs"
          }
        },
        {
          "act": {
            "this": "t1",
            "form": "wind_strings"
          },
          "receipt": "cycle-1",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "t1",
