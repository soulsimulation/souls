{
  "format": "souls-effect-cases/1",
  "about": "eden:tent (SA-X24): open the flap, then lie or sleep inside and get up; close it again. Pitched where it stands.",
  "cases": [
    {
      "name": "tent_sleep_get_up_lie",
      "state": {
        "actor": "b1",
        "nodes": {
          "room": { "loose": ["b1", "b2", "t1"] },
          "t1": { "kind": "eden:tent", "fields": { "open": true } },
          "b1": { "hands": { "left": null, "right": null } },
          "b2": { "hands": { "left": null, "right": null } }
        }
      },
      "do": [
        {
          "act": { "this": "t1", "form": "sleep", "args": { "place": "inside" } },
          "receipt": "rc1",
          "expect": {
            "verdict": "yes",
            "changes": [
              { "change": "reparent", "node": "b1", "to": { "node": "t1", "slot": "inside" } },
              { "change": "link", "node": "t1", "link": "sleeper", "n": 1, "end": "b1" }
            ],
            "events": [
              { "event": "eden:fell_asleep", "node": "t1", "changes": [0] },
              { "event": "eden:lying_in", "node": "t1", "changes": [1] }
            ]
          }
        },
        {
          "actor": "b2",
          "act": { "this": "t1", "form": "sleep", "args": { "place": "inside" } },
          "receipt": "rc2",
          "expect": { "verdict": "no", "reason": "slot_taken", "need": 1, "fix": null }
        },
        {
          "act": { "this": "t1", "form": "get_up" },
          "receipt": "rc3",
          "expect": {
            "verdict": "yes",
            "changes": [
              { "change": "unlink", "node": "t1", "link": "sleeper", "n": 1, "end": "b1" },
              { "change": "reparent", "node": "b1", "to": { "node": "room" } }
            ],
            "events": [
              { "event": "eden:got_up", "node": "t1", "changes": [0] },
              { "event": "eden:stood_by", "node": "t1", "changes": [1] }
            ]
          }
        },
        {
          "act": { "this": "t1", "form": "lie", "args": { "place": "inside" } },
          "receipt": "rc4",
          "expect": {
            "verdict": "yes",
            "changes": [
              { "change": "reparent", "node": "b1", "to": { "node": "t1", "slot": "inside" } },
              { "change": "link", "node": "t1", "link": "sleeper", "n": 1, "end": "b1" }
            ],
            "events": [
              { "event": "eden:lay_down", "node": "t1", "changes": [0] },
              { "event": "eden:lying_in", "node": "t1", "changes": [1] }
            ]
          }
        }
      ],
      "after": {
        "t1": {
          "kind": "eden:tent",
          "fields": { "open": true },
          "slots": { "inside": ["b1"] },
          "links": { "sleeper": ["b1"] }
        }
      }
    },
    {
      "name": "tent_open_sleep_close",
      "state": {
        "actor": "b1",
        "nodes": {
          "room": { "loose": ["b1", "t1"] },
          "t1": { "kind": "eden:tent" },
          "b1": { "hands": { "left": null, "right": null }, "effector_mm": [0, 800, 1300] }
        },
        "moves": { "press": { "reach_mm": 600 } }
      },
      "do": [
        {
          "act": { "this": "t1", "form": "sleep", "args": { "place": "inside" } },
          "receipt": "rc1",
          "expect": { "verdict": "no", "reason": "field_differs", "need": 0, "fix": { "form": "open_flap" } }
        },
        {
          "act": { "this": "t1", "form": "open_flap" },
          "receipt": "rc2",
          "expect": {
            "verdict": "yes",
            "changes": [{ "change": "set", "node": "t1", "field": "open", "n": 1, "to": 1 }],
            "events": [{ "event": "eden:flap_opened", "node": "t1", "changes": [0] }],
            "timers": []
          }
        },
        {
          "act": { "this": "t1", "form": "close_flap" },
          "receipt": "rc3",
          "expect": {
            "verdict": "yes",
            "changes": [{ "change": "set", "node": "t1", "field": "open", "n": 1, "to": 0 }],
            "events": [{ "event": "eden:flap_closed", "node": "t1", "changes": [0] }],
            "timers": []
          }
        }
      ],
      "after": { "t1": { "kind": "eden:tent", "fields": { "open": 0 } } }
    }
  ]
}
