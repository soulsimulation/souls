{
  "format": "souls-effect-cases/1",
  "about": "The crank lamp's timer (from #1873), handed back by SA-X0 (#3024). A 15 s shine at 15 s left a pending goes_dark timer due at 30 s (t1); the lamp was put out early at 18 s. Lit again at 20 s for 5 s, its new goes_dark timer replaces t1 (the engine clears it, Engine v2 T6 rule 15), so the lamp is not put out at 30 s by the earlier timer but at 25 s by its own. A timer is named by the form it starts: another lamp's pending timer, and a pending timer of another form on this lamp, are not replaced.",
  "cases": [
    {
      "name": "lit_again_replaces_the_earlier_timer",
      "state": {
        "actor": "b1",
        "now_us": 20000000,
        "nodes": {
          "room": { "loose": ["b1", "l1", "l2"] },
          "l1": { "kind": "eden:crank_lamp", "fields": { "charge": 3, "on": false }, "timers": [{ "id": "t1", "form": "goes_dark", "due_us": 30000000 }, { "id": "t9", "form": "other", "due_us": 40000000 }] },
          "l2": { "kind": "eden:crank_lamp", "fields": { "charge": 0, "on": true }, "timers": [{ "id": "t2", "form": "goes_dark", "due_us": 21000000 }] },
          "b1": { "hands": { "left": null, "right": null }, "effector_mm": [0, 250, 200] }
        },
        "moves": { "press": { "reach_mm": 600 } }
      },
      "do": [
        {
          "act": { "this": "l1", "form": "shine_5s" }, "now_us": 20000000, "receipt": "rt1",
          "expect": {
            "verdict": "yes",
            "changes": [
              { "change": "set", "node": "l1", "field": "charge", "n": 1, "to": 2 },
              { "change": "set", "node": "l1", "field": "on", "n": 2, "to": 1 }
            ],
            "events": [
              { "event": "eden:charge_spent", "node": "l1", "changes": [0] },
              { "event": "eden:lit", "node": "l1", "changes": [1] },
              { "event": "eden:will_go_dark", "node": "l1", "changes": [] }
            ],
            "timers": [{ "node": "l1", "form": "goes_dark", "after_us": 5000000, "event": 2, "replaces": ["t1"] }]
          }
        }
      ]
    },
    {
      "name": "first_light_replaces_nothing",
      "state": {
        "actor": "b1",
        "now_us": 0,
        "nodes": {
          "room": { "loose": ["b1", "l1"] },
          "l1": { "kind": "eden:crank_lamp", "fields": { "charge": 2 }, "timers": [] },
          "b1": { "hands": { "left": null, "right": null }, "effector_mm": [0, 250, 200] }
        },
        "moves": { "press": { "reach_mm": 600 } }
      },
      "do": [
        {
          "act": { "this": "l1", "form": "shine_10s" }, "now_us": 0, "receipt": "rt2",
          "expect": { "verdict": "yes", "timers": [{ "node": "l1", "form": "goes_dark", "after_us": 10000000, "event": 2 }] }
        }
      ]
    }
  ]
}
