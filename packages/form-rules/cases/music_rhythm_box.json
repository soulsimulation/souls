      "state": {"actor":"b1","nodes":{"r1":{"kind":"eden:rhythm_box"},"b1":{"hands":{"left":null,"right":null}}}},
      "asker": {"sees":["public"]},
      "expect": {"verdict":"yes"}
    },
    {
