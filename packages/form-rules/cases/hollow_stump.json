      "act": {
        "this": "st",
        "form": "search"
      },
      "state": {
        "actor": "b1",
        "nodes": {
          "st": {
            "kind": "eden:hollow_stump",
            "slots": {
              "inside": [
                "ap"
              ]
            }
          },
          "ap": {
            "kind": "eden:apple"
          },
          "b1": {
            "hands": {
              "right": null
            }
          }
        }
      },
      "asker": {
        "sees": [
          "creator"
        ]
      },
      "expect": {
        "verdict": "yes"
      }
    },
    {
