      "steps": [{ "step": "move", "move": "pour", "at": "spout", "toward": { "arg": "into" } }],
      "effects": [{ "change": "transfer", "field": "water_g", "from": "this", "into": { "arg": "into" }, "amount": 250, "event": "poured" }]
