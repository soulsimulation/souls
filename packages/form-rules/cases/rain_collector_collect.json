      "asker": { "sees": ["public"] },
      "expect": { "verdict": "no", "reason": "not_linked", "need": 3, "detail": { "link": "place", "count": 0 }, "fix": null, "says": "no_rain" }
    },
    {
      "name": "collect_place_kind_without_the_field_is_bad_input_without_words",
      "act": { "this": "r1", "form": "collect" },
