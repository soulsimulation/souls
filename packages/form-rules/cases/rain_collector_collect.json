    },
    {
      "name": "collect_dry_by_default",
      "act": { "this": "r1", "form": "collect" },
      "state": { "actor": "b1", "nodes": { "o1": { "kind": "test:open_air" }, "r1": { "kind": "eden:rain_collector", "fields": { "covered": false }, "links": { "place": ["o1"] } }, "b1": { "hands": { "left": null, "right": null } } } },
      "asker": { "sees": ["public"] },
      "expect": { "verdict": "no", "reason": "field_differs", "need": 3, "detail": { "node": "o1", "field": "rain", "found": 0, "wanted": { "at_least": 101 } }, "fix": null, "says": "no_rain" }
    },
    {
      "name": "collect_standing_in_no_place",
