      "act": { "this": "g1", "form": "read" },
      "state": { "actor": "b1", "nodes": { "o1": { "kind": "test:open_air" }, "g1": { "kind": "test:gauge", "links": { "place": ["o1"] } }, "b1": { "hands": { "left": null, "right": null } } } },
      "asker": { "sees": ["creator"] },
      "expect": { "verdict": "no", "reason": "field_differs", "need": 0, "detail": { "node": "o1", "field": "survey", "found": 0, "wanted": { "at_least": 1 } }, "fix": null }
    }
