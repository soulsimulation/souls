      "asker": { "sees": ["public"] },
      "expect": { "verdict": "no", "reason": "bad_input", "need": 3, "detail": { "what": "no_such_field", "node": "t1", "field": "rain" }, "fix": null }
    },
    {
      "name": "gauge_place_field_outside_the_audience_is_unknown",
      "act": { "this": "g1", "form": "read" },
      "state": { "actor": "b1", "nodes": { "o1": { "kind": "test:open_air", "fields": { "survey": 2 } }, "g1": { "kind": "test:gauge", "links": { "place": ["o1"] } }, "b1": { "hands": { "left": null, "right": null } } } },
      "asker": { "sees": ["public"] },
      "expect": { "verdict": "unknown", "need": 0, "node": "o1", "field": "survey" }
    },
    {
      "name": "gauge_place_field_seen_by_its_audience",
      "act": { "this": "g1", "form": "read" },
      "state": { "actor": "b1", "nodes": { "o1": { "kind": "test:open_air", "fields": { "survey": 2 } }, "g1": { "kind": "test:gauge", "links": { "place": ["o1"] } }, "b1": { "hands": { "left": null, "right": null } } } },
      "asker": { "sees": ["creator"] },
      "expect": { "verdict": "yes", "read": [["g1/link/1", 1], ["o1/field/2", 2]] }
