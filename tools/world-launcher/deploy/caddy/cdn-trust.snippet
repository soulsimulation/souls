# Lane E1 (#2513): which peers may name the visitor. Imported INSIDE the global options block of /etc/caddy/Caddyfile
# (a site file cannot hold global options), so it applies to every site on this host, and only to requests whose TCP
# peer is in these ranges: Cloudflare's published list (https://www.cloudflare.com/ips-v4 and /ips-v6). Static, because
# the dynamic `cloudflare` range module needs a custom Caddy build. For such a peer {client_ip} is the CF-Connecting-IP
# value (Cloudflare overwrites whatever a visitor sent in it); for any other peer, or a missing or invalid header, it is
# the peer itself. soul-game.caddy forwards exactly {client_ip} as X-Forwarded-For. check-soul-game.mjs (point 6) diffs
# these ranges against the published list. They stay on ONE line: Caddy reads the static source's ranges as arguments
# only, and silently drops ranges written inside a { } block (it adapts to a trusted_proxies with no ranges at all).
servers {
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	client_ip_headers CF-Connecting-IP
}
