# soul.game after the switch (Engine v2 O19, #2830): the front door sends each world to the system that serves it. It
# replaces tools/world-launcher/deploy/caddy/soul-game.caddy as /etc/caddy/sites/soul-game.caddy at the cut-over (X7);
# sim-eden-art.caddy (beside today's file) stays as it is, souls-game.caddy (beside this one) is added, and
# cdn-trust.snippet stays in the global options. Switch and switch back: v2/tools/ops/proxy/README.md.
#
# @@PRODUCTION_PORT@@ is a placeholder, never a real value in this repository: today's launcher's loopback port, as in
# today's file. The new system's loopback addresses are the install's (v2/docs/runbook/install.md): the directory on
# 7310, the viewers' origin on 7320, the agents' relay on 7330, the body files in /usr/local/lib/souls/web.
#
# Since 0.132 Core (F4): the front door keeps the old home. Today's launcher serves every page and every API it has
# always served: /, sign-in and account (/v1/account/*, /v1/auth/config), the world list, the site's pages, sitemap,
# and each world's page, client files and API, a switched world's included. For a switched world the launcher itself
# writes the v2 stream into the old page and serves the replica (tools/world-launcher/cutover.mjs; v2/docs/cutover.md).
# Only these go to the new system:
# - Streams: /s/* to the viewers' origin (7320), the stream a switched world's old page reads.
# - A switched world's gateway: /w/<slug>/v2/(ws|creator-token|entries), its creator's (creator-upload|creator-edit|
#   creator-helper|kinds, #1960) and its allowed uploads, /w/<slug>/v2/uploads/<hash> (K3: a creator's kind's model,
#   which the old page draws), to the agents' relay (7330, #4152), only for a
#   slug with an activation file in /var/lib/souls-routes/slugs (routes.mjs, run each minute by souls-routes.timer).
#   Every other address under /w/<slug>/ stays with today's launcher; an unmapped slug's v2 paths do too.
# - A switched world's bootstrap, /w/<slug>/v1/bootstrap, to the viewers' origin (7320), under the same activation
#   rule: the new Soul client reads it to pair with the world.
# - Pairing, for the new Soul client: /pair (the pairing card, built by the old page's build: pair.html in today's
#   release, X2; its own script files from there too), /v1/pair/* and /v1/agent/account[/*] to the directory (7310),
#   and /v1/account/view-token (the old page's sign-in exchanged for the owner's message box, #4250); every other
#   /v1/account/* path and /v1/auth/config stay with today's launcher.
# - Body files: /assets/* comes from the install's page folder (/usr/local/lib/souls/web: the body files under
#   assets/bodies/, v2/tools/ops/release/bodies.ts) where such a file exists, else from today's launcher.
# - The visitor's address: X-Forwarded-For is replaced with {client_ip}, trusted only from cdn-trust.snippet's ranges.
# - Pages refuse framing by other sites; API answers are not indexed. Neither replaces a header the answer already has.
# - When an origin cannot answer, a page a browser asked for gets today's poster ("back in a moment"), as before.
https://soul.game {
	header {
		?X-Frame-Options SAMEORIGIN
		?Content-Security-Policy "frame-ancestors 'self'"
	}
	@api path /__sim/* /v1/* /w/*/v1/* /w/*/v2/* /s/*
	header @api ?X-Robots-Tag "noindex, nofollow"

	@agents path_regexp agents ^/w/([a-z0-9][a-z0-9-]{0,62})/v2/(ws|creator-token|creator-upload|creator-edit|creator-helper|entries|kinds|uploads/1220[0-9a-f]{64})$
	handle @agents {
		# The outer match sets the slug capture before the dependent activation-file lookup.
		@active file {
			root /var/lib/souls-routes/slugs
			try_files /{re.agents.1}
		}
		handle @active {
			header X-Souls-System v2
			reverse_proxy localhost:7330 {
				header_up X-Forwarded-For {client_ip}
			}
		}
		handle {
			header X-Souls-System today
			reverse_proxy localhost:@@PRODUCTION_PORT@@ {
				header_up X-Forwarded-For {client_ip}
			}
		}
	}
	# A switched world's bootstrap, which the new Soul client reads to pair (`souls.mjs pair https://soul.game/w/<slug>/`)
	@bootstrap path_regexp bootstrap ^/w/([a-z0-9][a-z0-9-]{0,62})/v1/bootstrap$
	handle @bootstrap {
		@active file {
			root /var/lib/souls-routes/slugs
			try_files /{re.bootstrap.1}
		}
		handle @active {
			header X-Souls-System v2
			reverse_proxy localhost:7320 {
				header_up X-Forwarded-For {client_ip}
			}
		}
		handle {
			header X-Souls-System today
			reverse_proxy localhost:@@PRODUCTION_PORT@@ {
				header_up X-Forwarded-For {client_ip}
			}
		}
	}
	@pair path /pair /pair/
	handle @pair {
		header X-Souls-System v2
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /pair.html
		root * /srv/sim-worlds/production/apps/web/dist
		file_server
	}
	# the card's own script files, from the same build, so the card works while today's launcher is down (X2)
	@card {
		path_regexp card ^/assets/(pairing|modulepreload-polyfill)-[A-Za-z0-9_-]+\.js$
		file {
			root /srv/sim-worlds/production/apps/web/dist
		}
	}
	handle @card {
		header X-Souls-System v2
		root * /srv/sim-worlds/production/apps/web/dist
		file_server
	}
	@v2file {
		path /assets/*
		file {
			root /usr/local/lib/souls/web
		}
	}
	handle @v2file {
		header X-Souls-System v2
		root * /usr/local/lib/souls/web
		file_server
	}
	# /v1/account/view-token: the old page exchanges its sign-in there for the owner's message box (#4250); the owner's
	# Souls on the new engine and their names (/v1/account/souls, /v1/account/souls/profile: the navbar and the approval
	# card on a world page, first day 25 Nov), which the launcher does not serve
	@pairing path /v1/pair/* /v1/agent/account /v1/agent/account/* /v1/account/view-token /v1/account/souls /v1/account/souls/profile
	handle @pairing {
		header X-Souls-System v2
		reverse_proxy localhost:7310 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle_path /s/* {
		header X-Souls-System v2
		reverse_proxy localhost:7320 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		header X-Souls-System today
		reverse_proxy localhost:@@PRODUCTION_PORT@@ {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle_errors {
		@poster {
			expression `{http.error.status_code} in [502, 503, 504]`
			method GET
			header Accept *text/html*
			not path /__sim/* /v1/* /w/*/v1/* /s/*
		}
		handle @poster {
			root * /srv/sim-worlds/production/tools/world-launcher/deploy/caddy
			rewrite * /poster.html
			header Cache-Control no-store
			header Retry-After 5
			file_server {
				status 503
			}
		}
	}
}
