#!/usr/bin/env node
// O24: approve a waiting test-Soul pairing from the directory's own machine. No file access or bearer token.
import { isMain } from '../../../tools/lib/is-main.mjs';

export async function run(args, request = fetch) {
  const flag = args.indexOf('--directory');
  if (flag < 0 || !args[flag + 1]) throw new Error('Use --directory <direct HTTP loopback origin>');
  const origin = new URL(args[flag + 1]);
  args = [...args.slice(0, flag), ...args.slice(flag + 2)];
  const host = origin.hostname.replace(/^\[|\]$/g, '');
  if (origin.protocol !== 'http:' || origin.username || origin.password || origin.search || origin.hash
      || origin.pathname !== '/' || !(host === 'localhost' || host === '::1' || /^127(?:\.\d{1,3}){3}$/.test(host))) {
    throw new Error('operator.direct-only');
  }
  const [action, first, second, ...extra] = args;
  let body;
  if (action === 'approve' && first && second && !extra.length) body = { world: first, code: second };
  else if (action === 'list' && args.length === 1) body = {};
  else if (action === 'retire' && first && args.length === 2) body = { soul: first };
  else throw new Error('Use test-soul approve <world> <request> | list | retire <soul>, with --directory <origin>');
  const response = await request(new URL(`/v1/pair/operator/${action}`, origin), {
    method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
    redirect: 'error', signal: AbortSignal.timeout(10_000),
  });
  const result = await response.json();
  if (!response.ok) throw new Error(result.refused ?? `directory.status-${response.status}`);
  return result;
}

if (isMain(import.meta.url)) {
  run(process.argv.slice(2)).then((v) => console.log(JSON.stringify(v))).catch((e) => {
    console.error(JSON.stringify({ refused: e.message }));
    process.exitCode = 1;
  });
}
