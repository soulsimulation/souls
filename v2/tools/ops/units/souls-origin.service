# The viewers' origin (Engine v2 V2, #2711; installed by v2/tools/ops/install.sh, O17 #2810): a plain file server
# over the folder the worlds' view tier writes, on loopback only; the proxy and caches sit in front of it. It only reads.
[Unit]
Description=Souls viewers' origin
After=network-online.target
Wants=network-online.target

[Service]
User=souls
Group=souls
Slice=souls.slice
# Public provider fields and private ops owner/upstream settings; never receives secrets.env.
EnvironmentFile=-/etc/souls/origin.env
# Starts ORIGIN_PROCESSES serving processes on the one port (default: the cores less 2 for the worlds; 6 on 8 cores)
# and starts again any that ends. Stop signals only the starter, which ends the rest; a process the kernel kills for
# memory is started again by the starter while the others keep serving (OOMPolicy=continue).
ExecStart=/usr/bin/env node /usr/local/lib/souls/origin/origin.mjs /var/lib/souls/views 7320 localhost
KillMode=mixed
OOMPolicy=continue
Restart=always
RestartSec=1s
# For all of them: about 55 MB each idle (7 Node processes on 8 cores), 32 MB of held buffers each, and a join wave's
# requests in flight (#4018: 256M held one process). Inside souls.slice's 3G.
MemoryMax=1G
MemorySwapMax=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
