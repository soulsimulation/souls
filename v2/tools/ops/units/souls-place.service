# Initialization is finite and separate from the directory's 256M envelope. Actual worlds use worldd@ exclusively.
[Unit]
Description=Souls created-world initialization
After=souls-directory.service

[Service]
Type=oneshot
User=root
Group=souls
Slice=souls.slice
ExecStart=/usr/bin/env node /usr/local/lib/souls/ops/place-created-world.mjs
CPUWeight=100
MemoryMax=2G
MemorySwapMax=0
TimeoutStartSec=300s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/souls /etc/souls /etc/systemd/system
