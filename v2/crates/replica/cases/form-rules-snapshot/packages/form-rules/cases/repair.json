{
  "format": "souls-form-cases/1",
  "about": "Repair and mending (SA-X12, #2907), from the merged rules of #1074 (the bench and its hammer), #1575 (tent canvas and the sewing awl) and #1641 (the ceramic bowl and the lacquer brush), all one faculty in mending.ts. A thing is repaired only while it is broken ('<the thing> is not broken.'), only with its tool in a hand ('<the thing> needs a hammer in your hand, and there is no hammer within reach here.'; the original fetched the nearest tool on the way, which is this refusal's fix, a take of that kind), and a bench only with nobody on it ('Someone is sitting on the bench; it can't be repaired under them.'). Where to stand ('There is no room to stand and work at the bench.') is the world's answer, not a need. The bench's sit form is the seating bench's, unchanged.",
  "cases": [
    {
      "name": "bench_sit_every_need_met",
      "act": { "this": "rb1", "form": "sit", "args": { "seat": "left" } },
      "state": { "actor": "b1", "nodes": { "rb1": { "kind": "eden:repairable_bench" }, "b1": { "hands": { "left": null, "right": null } } } },
      "asker": { "sees": ["public"] },
      "expect": { "verdict": "yes" }
    },
    {
      "name": "bench_sit_seat_taken",
      "act": { "this": "rb1", "form": "sit", "args": { "seat": "left" } },
      "state": { "actor": "b1", "nodes": { "rb1": { "kind": "eden:repairable_bench", "slots": { "left": ["b2"] } }, "b1": { "hands": { "left": null, "right": null } }, "b2": {} } },
      "asker": { "sees": ["public"] },
      "expect": { "verdict": "no", "reason": "slot_taken", "need": 0 }
    },
    {
      "name": "bench_repair_every_need_met",
      "act": { "this": "rb1", "form": "repair" },
      "state": { "actor": "b1", "nodes": { "rb1": { "kind": "eden:repairable_bench", "fields": { "condition": "cracked" } }, "h1": { "kind": "eden:hammer" }, "b1": { "hands": { "left": null, "right": "h1" } } } },
      "asker": { "sees": ["public"] },
      "expect": { "verdict": "yes" }
    },
    {
      "name": "bench_repair_not_broken",
      "act": { "this": "rb1", "form": "repair" },
