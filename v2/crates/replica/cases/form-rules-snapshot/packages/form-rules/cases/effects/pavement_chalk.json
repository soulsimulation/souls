{
  "format": "souls-effect-cases/1",
  "about": "eden:pavement_chalk (SA-X7, #2902; from #1739): eight sticks of each colour, up to eight strokes, an erase that makes room and gives no chalk back.",
  "cases": [
    {
      "name": "draw_each_colour_fill_erase_and_the_chalk_stays_spent",
      "state": {
        "actor": "b1",
        "nodes": {
          "room": {
            "loose": [
              "b1",
              "p1"
            ]
          },
          "b1": {
            "hands": {
              "left": null,
              "right": null
            }
          },
          "p1": {
            "kind": "eden:pavement_chalk",
            "fields": {
              "red": 1,
              "blue": 8,
              "yellow": 8,
              "strokes": 6
            }
          }
        }
      },
      "do": [
        {
          "act": {
            "this": "p1",
            "form": "draw_red"
          },
          "receipt": "rp1",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "p1",
                "field": "red",
                "n": 1,
                "to": 0
              },
              {
                "change": "set",
                "node": "p1",
                "field": "strokes",
                "n": 4,
                "to": 7
              }
            ],
            "events": [
              {
                "event": "eden:chalk_used",
                "node": "p1",
                "changes": [
                  0
                ]
              },
              {
                "event": "eden:stroke_drawn",
                "node": "p1",
                "changes": [
                  1
                ]
              }
            ]
          }
        },
        {
          "act": {
            "this": "p1",
            "form": "draw_red"
          },
          "receipt": "rp2",
          "expect": {
            "verdict": "no",
            "reason": "field_differs",
            "need": 0
          }
        },
        {
          "act": {
            "this": "p1",
            "form": "draw_blue"
          },
          "receipt": "rp3",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "p1",
                "field": "blue",
                "n": 2,
                "to": 7
              },
              {
                "change": "set",
                "node": "p1",
                "field": "strokes",
                "n": 4,
                "to": 8
              }
            ]
          }
        },
        {
          "act": {
            "this": "p1",
            "form": "draw_yellow"
          },
          "receipt": "rp4",
          "expect": {
            "verdict": "no",
            "reason": "field_differs",
            "need": 1
          }
        },
        {
          "act": {
            "this": "p1",
            "form": "erase"
          },
          "receipt": "rp5",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "p1",
                "field": "strokes",
                "n": 4,
                "to": 7
              }
            ],
            "events": [
              {
                "event": "eden:stroke_erased",
                "node": "p1",
                "changes": [
                  0
                ]
              }
            ]
          }
        },
        {
          "act": {
            "this": "p1",
            "form": "draw_yellow"
          },
          "receipt": "rp6",
          "expect": {
            "verdict": "yes",
            "changes": [
              {
                "change": "set",
                "node": "p1",
                "field": "yellow",
                "n": 3,
                "to": 7
              },
              {
                "change": "set",
                "node": "p1",
                "field": "strokes",
                "n": 4,
                "to": 8
              }
            ]
          }
        }
      ],
      "after": {
        "p1": {
          "kind": "eden:pavement_chalk",
          "fields": {
            "red": 0,
            "blue": 7,
            "yellow": 7,
            "strokes": 8
          }
        }
      }
    }
  ]
}
