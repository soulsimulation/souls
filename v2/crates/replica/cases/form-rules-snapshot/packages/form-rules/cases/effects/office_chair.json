{
  "format": "souls-effect-cases/1",
  "about": "eden:office_chair (SA-X24): one seat that spins and stops by itself; on castors, so one Soul rolls it.",
  "cases": [
    {
      "name": "office_chair_two_souls_sit",
      "state": {
        "actor": "b1",
        "nodes": {
          "room": { "loose": ["b1", "b2", "t1"] },
          "t1": { "kind": "eden:office_chair" },
          "b1": { "hands": { "left": null, "right": null } },
          "b2": { "hands": { "left": null, "right": null } }
        }
      },
      "do": [
        {
          "act": { "this": "t1", "form": "sit", "args": { "seat": "seat" } },
          "receipt": "rc1",
          "expect": {
            "verdict": "yes",
            "changes": [{ "change": "reparent", "node": "b1", "to": { "node": "t1", "slot": "seat" } }],
            "events": [{ "event": "eden:sat_down", "node": "t1", "changes": [0] }]
          }
        }
      ],
      "after": { "t1": { "kind": "eden:office_chair", "slots": { "seat": ["b1"] } } }
    },
    {
      "name": "office_chair_spin_then_stop",
      "state": {
        "actor": "b1",
        "nodes": {
          "room": { "loose": ["b1", "t1"] },
          "t1": { "kind": "eden:office_chair" },
          "b1": { "hands": { "left": null, "right": null } }
        }
      },
      "do": [
        {
          "act": { "this": "t1", "form": "spin" },
          "receipt": "rc1",
          "expect": {
            "verdict": "yes",
            "changes": [{ "change": "set", "node": "t1", "field": "spinning", "n": 28, "to": 1 }],
            "events": [
              { "event": "eden:spun", "node": "t1", "changes": [0] },
              { "event": "eden:slowing", "node": "t1", "changes": [] }
            ],
            "timers": [{ "node": "t1", "form": "stop", "after_us": 3000000, "event": 1 }]
          }
        },
        {
          "act": { "this": "t1", "form": "stop" },
          "receipt": "rc2",
          "expect": {
            "verdict": "yes",
            "changes": [{ "change": "set", "node": "t1", "field": "spinning", "n": 28, "to": 0 }],
            "events": [{ "event": "eden:stopped", "node": "t1", "changes": [0] }],
            "timers": []
          }
        }
      ],
      "after": { "t1": { "kind": "eden:office_chair", "fields": { "spinning": 0 } } }
    }
  ]
}
