    "shape": {"shapes":[{"kind":"cyl","at":[0,300,0],"r":180,"h":500,"segments":8,"tint":"frame","roll":90000},{"kind":"box","at":[0,150,0],"size":[460,260,360],"round":0,"tint":"frame"},{"kind":"box","at":[0,500,0],"size":[240,20,3560],"round":0,"tint":"plank","role":"boom","pivot":[0,490,0]},{"kind":"torus","at":[0,720,-1400],"r":150,"r2":25,"segments":6,"tint":"handle","yaw":90000,"arc":180000,"role":"boom","pivot":[0,490,0]},{"kind":"torus","at":[0,720,1400],"r":150,"r2":25,"segments":6,"tint":"handle","yaw":90000,"arc":180000,"role":"boom","pivot":[0,490,0]}],"palette":{"frame":"#7d8783","plank":"#d9534f","handle":"#2b2b2b"},"tags":["play","see-saw","playground","seat"],"round":20},
    "table": [
      {
        "part": "boom",
        "field": "low_end",
        "do": "rotate",
        "axis": "x",
        "at": { "end_1": 9000, "end_2": -9000 },
        "over_us": 1000000
      }
    ]
  },
  "text": {
