          "type": "slot",
          "select": { "of": "free_slots", "in": "this", "anchor": "me", "order": "nearest", "rank": 1 }
        }
      },
      "needs": [{ "need": "slot_free", "slot": { "arg": "place" } }],
      "steps": [{ "step": "walk_to", "point": { "arg": "place" } }, { "step": "sit", "slot": { "arg": "place" } }],
      "effects": [
        { "change": "link", "link": "rider", "from": "actor", "event": "got_on" },
        { "change": "reparent", "what": "actor", "into": { "arg": "place" }, "event": "sat_down" }
      ]
    },
    "get_off": {
      "who": { "link": "rider" },
      "starts": "act",
      "needs": [],
      "steps": [{ "step": "rise" }],
      "effects": [
        { "change": "unlink", "link": "rider", "from": "actor", "event": "got_off" },
        { "change": "reparent", "what": "actor", "into": "here", "event": "stood_up" }
      ]
    },
    "push_off_end_1": {
      "who": { "link": "rider" },
      "starts": "act",
      "needs": [{ "need": "state", "field": "low_end", "is": "end_1" }],
      "steps": [{ "step": "wait", "us": 2000000 }],
      "effects": [{ "change": "set", "field": "low_end", "to": "end_2", "event": "end_2_went_down" }]
    },
    "push_off_end_2": {
      "who": { "link": "rider" },
      "starts": "act",
      "needs": [{ "need": "state", "field": "low_end", "is": "end_2" }],
      "steps": [{ "step": "wait", "us": 2000000 }],
      "effects": [{ "change": "set", "field": "low_end", "to": "end_1", "event": "end_1_went_down" }]
    }
  },
  "roles": { "rider": { "need": "required", "places": { "in": "this", "slots": ["end_1", "end_2"] } } },
  "motion": { "how": "fixed" },
  "loose": { "ever": true },
  "looks": {
