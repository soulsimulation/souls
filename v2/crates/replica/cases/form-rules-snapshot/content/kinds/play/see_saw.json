      "audience": { "rule": "everyone" }
    }
  },
  "links": { "rider": { "n": 1, "from": "body", "most": 2, "audience": { "rule": "everyone" } } },
  "points": {
    "by_end_1": { "role": "stand", "at_mm": [0, 0, -1900] },
    "by_end_2": { "role": "stand", "at_mm": [0, 0, 1900] }
  },
  "slots": {
    "end_1": { "admits": "body", "posture": "sit", "most": 1, "at_mm": [0, 530, -1600], "stand": "by_end_1" },
    "end_2": { "admits": "body", "posture": "sit", "most": 1, "at_mm": [0, 530, 1600], "stand": "by_end_2" }
  },
  "geometry": { "bounds_mm": [500, 895, 3560] },
  "forms": {
    "ride": {
      "who": "anyone",
      "starts": "act",
      "takes": {
