      "who": "anyone", "starts": "act",
      "needs": [
        { "need": "hand", "free": true },
        { "need": "state", "field": "compost", "at_least": 1, "says": "already_empty" }
      ],
      "steps": [{ "step": "walk_to", "point": "stand" }, { "step": "wait", "us": 4000000 }],
      "effects": [{ "change": "set", "field": "compost", "to": 0, "event": "emptied" }]
    }
  },
  "motion": { "how": "fixed" },
  "loose": { "ever": true },
