{
  "format": "souls-entry/1",
  "kind": "eden:compost_bin",
  "owner": "thing",
  "state": {
    "compost": { "n": 28, "type": "int", "unit": "count", "default": 3, "min": 0, "max": 3, "audience": { "rule": "everyone" } }
