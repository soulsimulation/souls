      "steps": [
        { "step": "walk_to", "point": "work" },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [
        { "change": "set", "field": "coarse", "by": -1, "event": "coarse_returned" },
        { "change": "set", "field": "fine", "by": -2, "event": "fine_returned" },
        { "change": "set", "field": "mixed", "by": 1, "event": "batch_remixed" }
      ]
    }
  },
  "motion": { "how": "two_hands" },
  "loose": { "ever": true },
