{
  "format": "souls-entry/1",
  "kind": "eden:interval_station",
  "owner": "thing",
  "state": {
    "intervals": { "n": 1, "type": "int", "unit": "count", "default": 0, "min": 0, "max": 1000000000, "audience": { "rule": "everyone" } },
    "last_move": { "n": 2, "type": "enum", "values": ["none", "stretch", "jacks", "dance"], "default": "none", "audience": { "rule": "everyone" } }
  },
  "points": {
    "front": { "role": "stand", "at_mm": [0, 0, 1500], "yaw_mdeg": 180000 }
  },
  "geometry": { "bounds_mm": [700, 1200, 350] },
  "forms": {
    "stretch_interval": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "hand", "free": true }],
      "steps": [
        { "step": "walk_to", "point": "front" },
        { "step": "move", "move": "stretch" },
        { "step": "wait", "us": 6000000 },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [
        { "change": "set", "field": "intervals", "by": 1, "event": "interval_completed" },
        { "change": "set", "field": "last_move", "to": "stretch", "event": "last_move_noted" }
      ]
    },
    "jacks_interval": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "hand", "free": true }],
