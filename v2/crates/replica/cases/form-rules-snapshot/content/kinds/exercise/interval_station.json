        { "step": "walk_to", "point": "front" },
        { "step": "move", "move": "jump" },
        { "step": "wait", "us": 6000000 },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [
        { "change": "set", "field": "intervals", "by": 1, "event": "interval_completed" },
        { "change": "set", "field": "last_move", "to": "jacks", "event": "last_move_noted" }
      ]
    },
    "dance_interval": {
      "who": "anyone",
      "starts": "act",
      "needs": [{ "need": "hand", "free": true }],
      "steps": [
        { "step": "walk_to", "point": "front" },
        { "step": "move", "move": "dance" },
        { "step": "wait", "us": 6000000 },
        { "step": "wait", "us": 3000000 }
      ],
      "effects": [
        { "change": "set", "field": "intervals", "by": 1, "event": "interval_completed" },
        { "change": "set", "field": "last_move", "to": "dance", "event": "last_move_noted" }
      ]
    }
  },
  "motion": { "how": "fixed" },
  "loose": { "ever": true },
