    "table": [
      { "part": "light", "field": "last_move", "do": "tint", "at": { "none": "#3a3a3a", "stretch": "#5fb36a", "jacks": "#e0902f", "dance": "#c45fb0" } },
      { "part": "light", "field": "last_move", "do": "glow", "at": { "none": 0, "stretch": 1000, "jacks": 1000, "dance": 1000 } }
