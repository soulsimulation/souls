# A boat holding rooms (Engine v2 T2, #2641). No fixed levels: the boat's kind admits rooms, so rooms are its
# children and move with it, because a parent is a frame. Layout as in door.diag.
{
  1: [],
  2: {},
  3: [
    {1: 1, 2: "souls:place"},
    {1: 2, 2: "souls:boat", 3: 1},
    {1: 3, 2: "souls:room", 3: 2, 6: {1: "cabin"}},
    {1: 4, 2: "souls:room", 3: 2, 6: {1: "hold"}},
    {1: 5, 2: "souls:door", 3: 3},
    {1: 6, 2: "souls:body", 3: 3},
    {1: 7, 2: "souls:crate", 3: 4}
  ],
  4: [
    {1: 8, 2: "leads-to", 3: [5, 4], 4: 0, 5: 0}          # the cabin's hatch down to the hold
  ]
}
