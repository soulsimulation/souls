# A press (Engine v2 B2, #2681; v2/crates/replica/src/moves.rs). One hand reaches the thing's named point and pushes:
# contact is the instant start-up ends. Times in µs, reach in µm. From Soul Actions' content/moves (SA-D4).
{
  1: "souls:press", 2: 1,
  3: [{1: 2, 2: 2}],                        # claims any one manipulator
  4: [2],                                   # blocks the other manipulators while it runs
  5: [2],                                   # a new claim on a manipulator cancels it
  6: [{1: "souls:start-up", 2: 250000},     # contact at its end
      {1: "souls:recovery", 2: 300000}],
  7: {1: 2},                                # reaches with the hand it holds
  8: 600000,
  9: "souls:button"                         # the thing's named point (K3)
}
