# Rising from a slot (Engine v2 B3, #2682; v2/crates/replica/src/moves.rs). The sit in reverse: at contact `sim::slots`
# hands the body from the slot back to its seat's stand point, on its feet. A new claim on locomotion before then
# cancels it, and the body stays in the slot. Times in µs, reach in µm.
{
  1: "souls:rise", 2: 1,
  3: [{1: 1, 2: 1}],                        # claims every locomotion resource
  5: [1],                                   # a new claim on locomotion cancels it
  6: [{1: "souls:start-up", 2: 500000},     # rising; on its feet at the stand point at its end
      {1: "souls:recovery", 2: 300000}],
  7: {1: 1},                                # the body itself
  8: 600000,
  9: "souls:stand"
}
