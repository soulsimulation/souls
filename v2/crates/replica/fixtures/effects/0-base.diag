# The base (Engine v2 T6, #2645, v2/docs/effects.md): a small world, applied to the zone's root alone. Every other
# fixture is applied to the state this leaves. A part is {1: header hash, 2: [entry, ...]}; an entry is
# {1: sequence, 2: world time us, 3: cause, 4: actor, 5: audience, 6: node, then one body: 7: [change, ...],
# 9: transfer record, 10: [time effect, ...] or 11: [timer, ...]; and 8: [event, ...]}. Each entry writes only its
# own node (6) and what it creates under it. Ids are [scope, counter]: the world's scope is ee..ee, Souls' dd..dd, a
# creator's principal 77..77.
{
  1: h'12201b6152bdcb78adacbc5eb70d3aff3ee1fff947060db15527395c3c0706158db5',
  2: [
    {1: 0, 2: 0, 3: {1: 3}, 4: {1: 3}, 5: {1: 1}, 6: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 0],    # the world starts: caused by and acted by the world
     10: [
       {1: 1, 2: 0, 3: 1763337600000000, 4: [1, 1]},   # T5's mapping, a time record of its own (time.md rule 8)
       {1: 2, 2: 0, 3: 0, 4: 20},                      # T5's tick rate, 20 a second
       {1: 3, 2: 0, 3: 0, 4: [60000000, 130]}          # T5's tempo, 130 a minute
     ],
     8: [{1: "souls:world-start"}]},
    {1: 1, 2: 0, 3: {1: 1, 2: [h'77777777777777777777777777777777', 2]}, 4: {1: 2, 2: [h'77777777777777777777777777777777', 1]}, 5: {1: 1}, 6: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 0],   # a creator furnishes it: every node it writes it creates under the root
     7: [
       {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1], 3: "souls:room@12201891c9af912d72fad5e13fc896373e2a41d9c45fd82f51e1d6c081c2d776796e",
        4: {1: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 0]], 2: [0, 0, 0], 3: [1073741824, 0, 0, 0], 4: {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 0], 3: 0}}, 5: {1: 1}, 6: {}},
       {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 2], 3: "souls:body@1220ee1ad75a34f067112ef6d2a095fe5bd3e121a75611a1a95ba85198efcb131cb2",
        4: {1: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1]], 2: [2000000, 0, 1000000], 3: [1073741824, 0, 0, 0], 4: {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1], 3: 0}}, 5: {1: 1}, 6: {}},
       {1: 5, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 3], 3: "souls:body-of", 4: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 2], [h'dddddddddddddddddddddddddddddddd', 100]], 5: 0, 6: {1: 1}},   # Soul 100's body
       {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 4], 3: "souls:cup@1220edc856b3ff9da87e27ffb6a4a1a7266bb4ef737f93e481f79545dee2578a6bea",
        4: {1: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 2], 2], 2: [0, 0, 0], 3: [1073741824, 0, 0, 0], 4: {1: 2}}, 5: {1: 1}, 6: {1: 0}},   # in the right hand (slot 2)
       {1: 5, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 5], 3: "souls:owns", 4: [[h'dddddddddddddddddddddddddddddddd', 100], [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 4]], 5: 1, 6: {1: 1}},       # Soul 100 owns the cup
       {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 6], 3: "souls:key@1220781d89e0ae5ff74f79e61f020201f2128268af10ffa77355868f6c8497442ae1",
        4: {1: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1]], 2: [3000000, 0, 0], 3: [1073741824, 0, 0, 0], 4: {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1], 3: 0}}, 5: {1: 1}, 6: {}},
       {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 7], 3: "souls:crate@122090fbc4c3f786f2765b16b6014480381b4618c4ff6a429d4873ef92cf68440426",
        4: {1: [[h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1]], 2: [-1000000, 0, 2000000], 3: [1073741824, 0, 0, 0], 4: {1: 1, 2: [h'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee', 1], 3: 0}}, 5: {1: 1}, 6: {1: 1000}}
     ],
